# Copy to .env and change what you need. Real environment variables win over this file.

# Which model writes the drafts: fake (no AI, instant), ollama (local, free) or anthropic (Claude)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Only for LLM_PROVIDER=anthropic (also: pip install anthropic, and set ANTHROPIC_API_KEY)
ANTHROPIC_MODEL=claude-opus-5-5

# How approved emails go out: outbox (writes .eml files to ./outbox) or smtp (for example Mailpit)
EMAIL_SENDER=outbox
SMTP_HOST=localhost
SMTP_PORT=1025

# Safety guard: the send step refuses any address that doesn't end with one of these
ALLOWED_RECIPIENT_SUFFIXES=.example,.test

# Urgent alerts: with no webhook, they go to outbox/alerts.log. With one, n8n or Zapier can forward
# them to WhatsApp, Slack or Teams.
# ALERT_WEBHOOK_URL=http://localhost:5678/webhook/outreach-alerts

# DATABASE_PATH=data/outreach.db
